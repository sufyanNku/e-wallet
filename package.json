{
  "name": "e-wallet",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "packageManager": "pnpm@10.34.9",
  "engines": {
    "node": ">=24.15.0 <25"
  },
  "scripts": {
    "test:all:local": "tsx scripts/verify-application.ts",
    "demo:setup": "tsx scripts/setup-team-demo.ts",
    "demo:dev": "tsx scripts/dev-team-demo.ts",
    "test:demo": "pnpm build:wallet && playwright test --config playwright.team-demo.config.ts",
    "dev:ui": "vite --config apps/wallet/vite.config.ts --mode mock",
    "build:web": "vite build --config apps/wallet/vite.config.ts --mode mock",
    "serve:web": "tsx services/backend/src/server.ts",
    "typecheck": "tsc --noEmit",
    "lint": "eslint . && node scripts/check-boundaries.mjs",
    "test:unit": "vitest run",
    "test:ui": "playwright test",
    "dev:dapp": "tsx node_modules/vite/bin/vite.js --config apps/reference-dapp/vite.config.ts",
    "build:dapp": "tsx node_modules/vite/bin/vite.js build --config apps/reference-dapp/vite.config.ts",
    "verify:frontend": "node scripts/verify-phase1.mjs",
    "dev:wallet": "tsx scripts/dev.ts wallet",
    "build:wallet": "vite build --config apps/wallet/vite.config.ts --mode wallet-local",
    "build:testnet": "vite build --config apps/wallet/vite.config.ts --mode testnet",
    "test:core": "vitest run tests/core",
    "test:security": "vitest run tests/security",
    "verify:core": "node scripts/verify-phase2.mjs",
    "test:browser-core": "playwright test --config playwright.core.config.ts",
    "contracts:compile": "pnpm --filter @ewallet/contracts compile && tsx scripts/generate-abis.ts",
    "contracts:test": "pnpm --filter @ewallet/contracts test",
    "infra:up": "tsx scripts/infra.ts up",
    "infra:down": "tsx scripts/infra.ts down",
    "networks:check": "tsx scripts/networks-check.ts",
    "test:adapters": "vitest run tests/adapters",
    "deploy:local": "tsx scripts/seed-evm.ts",
    "seed:solana": "tsx scripts/seed-solana.ts",
    "test:browser-solana": "tsx scripts/test-solana-browser.ts",
    "build:metadata": "tsx scripts/build-metadata.ts",
    "seed:bitcoin": "tsx scripts/seed-bitcoin.ts",
    "test:browser-bitcoin": "tsx scripts/test-bitcoin-browser.ts",
    "dev": "tsx scripts/dev.ts",
    "preflight": "tsx scripts/preflight.ts",
    "seed:local": "tsx scripts/seed-local.ts",
    "seed:assert": "tsx scripts/assert-seed.ts",
    "reset:local": "tsx scripts/reset-local.ts",
    "test:integration": "vitest run tests/integration && tsx scripts/check-index-reorg.ts && tsx scripts/check-public-api.ts",
    "test:dapp": "pnpm build:wallet && playwright test --config playwright.dapp.config.ts && pnpm test:browser-solana && pnpm test:browser-bitcoin",
    "scenario": "tsx scripts/scenario.ts",
    "seed:testnets": "tsx scripts/seed-testnets.ts",
    "relayer": "tsx scripts/relayer.ts",
    "audit:verified": "tsx scripts/audit-verified.ts",
    "mobile": "pnpm --filter @ewallet/mobile start",
    "mobile:android": "pnpm --filter @ewallet/mobile android",
    "mobile:ios": "pnpm --filter @ewallet/mobile ios",
    "mobile:typecheck": "pnpm --filter @ewallet/mobile typecheck",
    "mobile:export": "pnpm --filter @ewallet/mobile export",
    "release:check": "tsx scripts/release-check.ts",
    "mobile:test:chains": "tsx scripts/test-native.ts",
    "mobile:build:android": "tsx scripts/build-android.ts"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.14.0",
    "@eslint/js": "10.0.1",
    "@metaplex-foundation/mpl-token-metadata-kit": "0.0.3",
    "@playwright/test": "1.65.0",
    "@solana-program/system": "0.16.0",
    "@solana-program/token": "0.18.0",
    "@solana-program/token-2022": "0.20.1",
    "@solana/kit": "8.6.0",
    "@tailwindcss/vite": "4.3.5",
    "@testing-library/jest-dom": "7.0.1",
    "@testing-library/react": "16.3.3",
    "@testing-library/user-event": "14.6.10",
    "@types/better-sqlite3": "9.6.0",
    "@types/node": "24.19.2",
    "@types/qrcode": "1.5.6",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.3.0",
    "better-sqlite3": "12.11.1",
    "bip32": "5.0.1",
    "bitcoinjs-lib": "7.0.5",
    "eslint": "10.14.0",
    "eslint-plugin-react-hooks": "7.1.1",
    "ethers": "6.17.0",
    "fake-indexeddb": "6.2.8",
    "fast-check": "4.10.2",
    "fastify": "5.12.8",
    "globals": "17.14.0",
    "ipaddr.js": "2.5.0",
    "jsdom": "27.4.0",
    "lossless-json": "4.3.3",
    "micro-key-producer": "0.10.2",
    "prettier": "3.8.3",
    "sharp": "0.35.5",
    "tailwindcss": "4.3.5",
    "tiny-secp256k1": "2.2.5",
    "tsx": "4.23.15",
    "typescript": "5.9.3",
    "typescript-eslint": "8.72.2",
    "vite": "8.3.8",
    "vite-plugin-wasm": "3.6.0",
    "vitest": "4.1.12",
    "zod": "4.6.7"
  },
  "pnpm": {
    "overrides": {
      "glob@>=9 <=14.0.1": "14.0.2",
      "minimatch@>=7 <11.0.1": "11.0.1",
      "tmp@>=0.2.6 <0.2.7": "0.2.7",
      "zod@>=4 <4.6.6": "4.6.7"
    },
    "patchedDependencies": {
      "zod@3.25.76": "patches/zod@3.25.76.patch"
    }
  }
}
