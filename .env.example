# Deployed test-network service; real funds are disabled.
EWALLET_DOMAIN=wallet.example.org
EWALLET_PUBLIC_ORIGINS=https://wallet.example.org
EWALLET_MODE=testnet
EWALLET_DATABASE_PATH=/data/backend.sqlite
# Native apps use the same HTTPS API. Never place RPC secrets in EXPO_PUBLIC variables.
EXPO_PUBLIC_API_URL=https://wallet.example.org
# Refuses cleartext API URLs when generating store-targeted native builds.
EWALLET_MOBILE_RELEASE=1
